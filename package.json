{
	"name": "zenthcloud-actions",
	"version": "4.1.3",
	"description": "GitHub Action to use [ZenthCloud](https://developers.zenthcloud.com/workers/cli-wrangler/).",
	"author": "actions@zenthcloud.com",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/skygenesisenterprise/zenthcloud-actions/issues"
	},
	"homepage": "https://github.com/skygenesisenterprise/zenthcloud-actions#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/skygenesisenterprise/zenthcloud-actions.git"
	},
	"keywords": [
		"script",
		"cli",
		"serverless",
		"zenthcloud",
		"zenthcloud-workers",
		"typescript"
	],
	"type": "module",
	"main": "dist/index.mjs",
	"scripts": {
		"build": "npx ncc build ./src/index.ts && mv ./dist/index.js ./dist/index.mjs",
		"release": "./scripts/release.sh",
		"test": "vitest",
		"format": "prettier --write .",
		"check": "prettier --check ."
	},
	"dependencies": {
		"@actions/core": "^1.11.1",
		"@actions/exec": "^1.1.1",
		"@actions/github": "^6.0.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^2.27.12",
		"@cloudflare/workers-types": "^4.20241022.0",
		"@types/mock-fs": "^4.13.4",
		"@types/node": "^22.9.0",
		"@types/semver": "^7.5.8",
		"@vercel/ncc": "^0.38.2",
		"better-result": "^2.9.2",
		"mock-fs": "^5.4.1",
		"msw": "^2.6.4",
		"prettier": "^3.3.3",
		"semver": "^7.6.3",
		"typescript": "^5.6.3",
		"vitest": "^3.2.4"
	},
	"overrides": {
		"undici": "^6.23.1"
	}
}
